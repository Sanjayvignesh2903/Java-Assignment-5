import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;

public class PassStore {
    private static final int BUFFER_SIZE = 8192; // 8 KB buffer
    private final Path file;

    PassStore(Path file) {
        this.file = file;
    }

    // (i) Add a new bus pass record to the CSV file
    public void add(String passId, String regNo, String name, int route, double amount)
            throws IOException {
        try (BufferedWriter w = Files.newBufferedWriter(file,
                StandardOpenOption.CREATE, StandardOpenOption.APPEND)) {
            w.write(String.join(",", passId, regNo, name,
                    String.valueOf(route), String.valueOf(amount)));
            w.newLine();
        }
    }

    // (ii) Find a pass by ID; skips damaged lines (not exactly 5 fields)
    public String[] find(String passId) throws IOException {
        if (!Files.exists(file)) {
            return null;
        }
        try (BufferedReader r = Files.newBufferedReader(file)) {
            String line;
            while ((line = r.readLine()) != null) {
                String[] fields = line.split(",", -1);
                if (fields.length != 5) {
                    continue; // Skip damaged line without stopping search
                }
                if (fields[0].equals(passId)) {
                    return fields;
                }
            }
        }
        return null;
    }

    // (iii) List all valid passes on a given route
    public List<String[]> listByRoute(int route) throws IOException {
        List<String[]> results = new ArrayList<>();
        if (!Files.exists(file)) {
            return results;
        }
        String targetRoute = String.valueOf(route);
        try (BufferedReader r = Files.newBufferedReader(file)) {
            String line;
            while ((line = r.readLine()) != null) {
                String[] fields = line.split(",", -1);
                if (fields.length != 5) {
                    continue; // Skip damaged line
                }
                if (fields[3].equals(targetRoute)) {
                    results.add(fields);
                }
            }
        }
        return results;
    }

    // --- Helper Methods for B1.3 Buffering Benchmark ---

    private static void generateLogFile(Path path, int sizeMB) throws IOException {
        byte[] line = "2026-11-21 09:00:00,192324061,PRESENT,BLOCK-A\n"
                .getBytes(StandardCharsets.UTF_8);
        long targetBytes = (long) sizeMB * 1024 * 1024;
        long written = 0;

        try (BufferedOutputStream bos = new BufferedOutputStream(
                new FileOutputStream(path.toFile()), BUFFER_SIZE)) {
            while (written < targetBytes) {
                bos.write(line);
                written += line.length;
            }
        }
    }

    private static long countLinesUnbuffered(File file) throws IOException {
        long lines = 0;
        try (FileInputStream fis = new FileInputStream(file)) {
            int b;
            while ((b = fis.read()) != -1) {
                if (b == '\n') {
                    lines++;
                }
            }
        }
        return lines;
    }

    private static long countLinesBuffered(File file) throws IOException {
        long lines = 0;
        byte[] buf = new byte[BUFFER_SIZE];
        try (FileInputStream fis = new FileInputStream(file)) {
            int n;
            while ((n = fis.read(buf)) != -1) {
                for (int i = 0; i < n; i++) {
                    if (buf[i] == '\n') {
                        lines++;
                    }
                }
            }
        }
        return lines;
    }

    // B1.1: Functional & Damaged-Line Validation
    private static void runValidationTests() throws IOException {
        System.out.println("=== B1.1: Validation Tests (Normal, Missing, Damaged) ===");
        Path f = Files.createTempFile("passes", ".csv");
        PassStore store = new PassStore(f);

        store.add("P1001", "192311001", "Arun", 12, 4500);
        Files.writeString(f, "P1002,DAMAGED LINE\n", StandardOpenOption.APPEND);
        store.add("P1003", "192311003", "Divya", 7, 3800);
        store.add("P1004", "192311004", "Kiran", 12, 4500);

        System.out.println("Find P1003 (valid)    : " + Arrays.toString(store.find("P1003")));
        System.out.println("Find P1002 (damaged)  : " + Arrays.toString(store.find("P1002")));
        System.out.println("Find P9999 (missing)  : " + Arrays.toString(store.find("P9999")));

        System.out.println("Passes on Route 12    :");
        for (String[] row : store.listByRoute(12)) {
            System.out.println("  " + Arrays.toString(row));
        }

        Files.deleteIfExists(f);
    }

    // B1.3: Buffering Benchmark (1 MB, 10 MB, 50 MB)
    private static void runBufferingExperiment() throws IOException {
        System.out.println("\n=== B1.3: Buffering Benchmark (1 MB, 10 MB, 50 MB) ===");
        System.out.printf("%-10s | %-15s | %-15s | %-10s%n",
                "File Size", "Unbuffered (ms)", "Buffered (ms)", "Speedup");
        System.out.println("----------------------------------------------------------");

        int[] sizes = {1, 10, 50};
        for (int mb : sizes) {
            Path temp = Files.createTempFile("log_" + mb + "mb_", ".txt");
            generateLogFile(temp, mb);
            File f = temp.toFile();

            long t1 = System.nanoTime();
            countLinesUnbuffered(f);
            long unbufMs = (System.nanoTime() - t1) / 1_000_000;

            long t2 = System.nanoTime();
            countLinesBuffered(f);
            long bufMs = (System.nanoTime() - t2) / 1_000_000;

            double speedup = (bufMs == 0) ? unbufMs : (double) unbufMs / bufMs;
            System.out.printf("%-10s | %-15d | %-15d | %.1fx%n",
                    mb + " MB", unbufMs, bufMs, speedup);

            Files.deleteIfExists(temp);
        }
    }

    // B1.4: Search Growth Benchmark (1,000 to 100,000 records)
    private static void runGrowthExperiment() throws IOException {
        System.out.println("\n=== B1.4: Search Growth Benchmark (Linear File Scan vs. HashMap) ===");
        System.out.printf("%-12s | %-18s | %-18s%n",
                "Records (n)", "File Scan (ms)", "HashMap Lookup (ns)");
        System.out.println("--------------------------------------------------------");

        int[] counts = {1_000, 10_000, 50_000, 100_000};
        for (int n : counts) {
            Path temp = Files.createTempFile("passes_" + n + "_", ".csv");
            Map<String, String[]> map = new HashMap<>(n);

            try (BufferedWriter bw = Files.newBufferedWriter(temp)) {
                for (int i = 1; i <= n; i++) {
                    String id = "P" + i;
                    String line = id + ",192324061,Student" + i + ",12,4500.0";
                    bw.write(line);
                    bw.newLine();
                    map.put(id, line.split(","));
                }
            }

            PassStore store = new PassStore(temp);
            String targetId = "P" + n; // Worst-case: last record in file

            long t1 = System.nanoTime();
            store.find(targetId);
            double scanMs = (System.nanoTime() - t1) / 1_000_000.0;

            long t2 = System.nanoTime();
            map.get(targetId);
            long mapNs = System.nanoTime() - t2;

            System.out.printf("%-12d | %-18.3f | %-18d%n", n, scanMs, mapNs);
            Files.deleteIfExists(temp);
        }
    }

    public static void main(String[] args) throws IOException {
        runValidationTests();
        runBufferingExperiment();
        runGrowthExperiment();
    }
}
